# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# For production (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.mongodb.net/gym_management?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/gym_management

# JWT Authentication Secrets
JWT_ACCESS_SECRET=super_secret_jwt_access_key_gym_prod_2026_xyz123
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_gym_prod_2026_abc987
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Allowed Frontend URL for CORS & Cookie SameSite
FRONTEND_URL=http://localhost:5173

# Admin Bootstrap Credentials
ADMIN_EMAIL=aniruddhsrivasta318@gmail.com
ADMIN_INITIAL_PASSWORD=AdminSecurePass@2026

# Gmail SMTP Transactional Email Configuration (Nodemailer, Host: smtp.gmail.com, Port: 465, Secure: true)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
EMAIL_FROM="Gym Management" <your_gmail_address@gmail.com>

# Cloudinary Storage for Member Profile Images (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=demo_api_key
CLOUDINARY_API_SECRET=demo_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
